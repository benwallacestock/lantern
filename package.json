{
  "name": "lantern-browser",
  "version": "0.1.0",
  "description": "A browser for coding agents: drive the app, take screenshots ready for a pull request, record a demo with captions and a visible pointer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lantern": "./dist/bin/lantern.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "logo.svg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/cli.test.ts",
    "release": "node scripts/release.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "browser",
    "agent",
    "claude-code",
    "codex",
    "screenshot",
    "demo",
    "recording",
    "cdp"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benwallacestock/lantern.git"
  },
  "homepage": "https://github.com/benwallacestock/lantern",
  "bugs": "https://github.com/benwallacestock/lantern/issues",
  "private": false
}

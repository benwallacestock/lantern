{
  "name": "@benwallacestock/lantern",
  "version": "0.4.3",
  "description": "A browser for coding agents: drive the app, take screenshots ready for a pull request, record a demo with captions and a visible pointer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lantern": "./dist/lantern.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "CHANGELOG.md",
    "logo.svg"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "release": "node scripts/release.ts",
    "build": "esbuild bin/lantern.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/lantern.js && chmod +x dist/lantern.js",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "browser",
    "agent",
    "claude-code",
    "codex",
    "screenshot",
    "demo",
    "recording",
    "cdp"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benwallacestock/lantern.git"
  },
  "homepage": "https://github.com/benwallacestock/lantern",
  "bugs": "https://github.com/benwallacestock/lantern/issues",
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
